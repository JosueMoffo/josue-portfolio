---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Portfolio de Josué Mbah Moffo - Étudiant en Génie Informatique & Aspirant Expert en Cybersécurité" } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr" class="scroll-smooth scroll-pt-16">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet" />
    
    <title>{title}</title>
    
    <style is:global>
      /* On ne garde que ce que Tailwind ne gère pas nativement proprement */
      ::-webkit-scrollbar { width: 8px; }
      ::-webkit-scrollbar-track { background: #0a0e1a; }
      ::-webkit-scrollbar-thumb { background: #1a1f2e; border-radius: 4px; }
      ::-webkit-scrollbar-thumb:hover { background: #00d9ff; }

      @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .animate-fade-in-up { animation: fadeInUp 0.6s ease-out forwards; }
    </style>
  </head>
  
  <body class="bg-night-950 text-slate-300 antialiased font-sans">
    <nav class="fixed top-0 left-0 right-0 z-50 bg-night-950/80 backdrop-blur-md border-b border-night-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <a href="#accueil" class="font-mono text-xl font-bold text-cyber-blue tracking-tighter">
            JMM.dev
          </a>
          
          <div class="hidden md:flex space-x-8">
            <a href="#accueil" class="text-slate-400 hover:text-cyber-blue transition-colors text-xs uppercase tracking-widest font-medium">Accueil</a>
            <a href="#parcours" class="text-slate-400 hover:text-cyber-blue transition-colors text-xs uppercase tracking-widest font-medium">Parcours</a>
            <a href="#competences" class="text-slate-400 hover:text-cyber-blue transition-colors text-xs uppercase tracking-widest font-medium">Compétences</a>
            <a href="#projets" class="text-slate-400 hover:text-cyber-blue transition-colors text-xs uppercase tracking-widest font-medium">Projets</a>
            <a href="#faq" class="text-slate-400 hover:text-cyber-blue transition-colors text-xs uppercase tracking-widest font-medium">FAQ</a>
          </div>
          
        <button id="mobile-menu-button" class="md:hidden text-slate-400 relative z-50">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <div id="mobile-menu" class="fixed inset-0 bg-night-950/95 backdrop-blur-lg z-40 hidden md:hidden">
          <div class="flex flex-col items-center justify-center h-full space-y-8">
            <a href="#accueil" class="mobile-link text-2xl text-slate-300 hover:text-cyber-blue transition-colors" onclick="closeMobileMenu()">Accueil</a>
            <a href="#parcours" class="mobile-link text-2xl text-slate-300 hover:text-cyber-blue transition-colors" onclick="closeMobileMenu()">Parcours</a>
            <a href="#competences" class="mobile-link text-2xl text-slate-300 hover:text-cyber-blue transition-colors" onclick="closeMobileMenu()">Compétences</a>
            <a href="#projets" class="mobile-link text-2xl text-slate-300 hover:text-cyber-blue transition-colors" onclick="closeMobileMenu()">Projets</a>
            <a href="#faq" class="mobile-link text-2xl text-slate-300 hover:text-cyber-blue transition-colors" onclick="closeMobileMenu()">FAQ</a>
          </div>
        </div>

        </div>
      </div>
    </nav>
    
    <main>
      <slot />
    </main>
    
    <footer class="bg-night-950 border-t border-night-800 py-12 mt-20">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <h3 class="text-white font-bold mb-4">Josué Mbah Moffo</h3>
        <p class="text-slate-500 text-sm max-w-md mx-auto mb-8">
          Ingénieur en formation à l'ENSPY. Spécialisation en développement sécurisé et administration systèmes.
        </p>
        <div class="flex justify-center space-x-6 text-xs uppercase tracking-widest">
          <a href="https://github.com/JosueMoffo" onclick="window.trackClick('Social_Link', { platform: 'GitHub' })" class="text-slate-400 hover:text-cyber-blue">GitHub</a>
          <a href="https://www.linkedin.com/in/josue-moffo-07b756352/" onclick="window.trackClick('Social_Link', { platform: 'Linkedin' })" class="text-slate-400 hover:text-cyber-blue">LinkedIn</a>
          <a href="mailto:josuemoffo@gmail.com" onclick="window.trackClick('Social_Link', { platform: 'Gmail' })" class="text-slate-400 hover:text-cyber-blue">📧 Contact</a>
        </div>
        <p class="mt-8 text-[10px] text-slate-700 uppercase tracking-[0.2em]">&copy; 2026 Tous droits réservés</p>
      </div>
    </footer>

    <Analytics />
    <SpeedInsights />

    <script>
      import { track } from '@vercel/analytics';

      // On utilise 'as any' pour éviter les erreurs de type TypeScript sur l'objet window
      (window as any).trackClick = (eventName, properties = {}) => { 
        track(eventName, properties);
      };
    </script>

    <script>
      // Gestion Menu Mobile complet
      const btn = document.getElementById('mobile-menu-button');
      const mobileMenu = document.getElementById('mobile-menu');
      
      if (btn && mobileMenu) {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          mobileMenu.classList.toggle('hidden');
          
          // Empêcher le scroll du body quand le menu est ouvert
          if (!mobileMenu.classList.contains('hidden')) {
            document.body.style.overflow = 'hidden';
          } else {
            document.body.style.overflow = '';
          }
        });

        // Fermer le menu quand on clique sur un lien
        const mobileLinks = document.querySelectorAll('.mobile-link');
        mobileLinks.forEach(link => {
          link.addEventListener('click', () => {
            mobileMenu.classList.add('hidden');
            document.body.style.overflow = '';
          });
        });

        // Fermer le menu si on clique en dehors (optionnel)
        mobileMenu.addEventListener('click', (e) => {
          if (e.target === mobileMenu) {
            mobileMenu.classList.add('hidden');
            document.body.style.overflow = '';
          }
        });

        // Gérer la fermeture avec la touche Echap
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && mobileMenu && !mobileMenu.classList.contains('hidden')) {
            mobileMenu.classList.add('hidden');
            document.body.style.overflow = '';
          }
        });
      }

      // Fonction globale pour fermer le menu (utilisée par les liens)
      window.closeMobileMenu = () => {
        const menu = document.getElementById('mobile-menu');
        if (menu) {
          menu.classList.add('hidden');
          document.body.style.overflow = '';
        }
      };
    </script>
  </body>
</html>