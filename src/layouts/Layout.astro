---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Portfolio de Josué Mbah Moffo - Étudiant en Génie Informatique & Aspirant Expert en Cybersécurité" } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr" class="scroll-smooth scroll-pt-16">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet" />
    
    <title>{title}</title>
    
    <style is:global>
      /* On ne garde que ce que Tailwind ne gère pas nativement proprement */
      ::-webkit-scrollbar { width: 8px; }
      ::-webkit-scrollbar-track { background: #0a0e1a; }
      ::-webkit-scrollbar-thumb { background: #1a1f2e; border-radius: 4px; }
      ::-webkit-scrollbar-thumb:hover { background: #00d9ff; }

      @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .animate-fade-in-up { animation: fadeInUp 0.6s ease-out forwards; }
    </style>
  </head>
  
  <body class="bg-night-950 text-slate-300 antialiased font-sans">
    <nav class="fixed top-0 left-0 right-0 z-50 bg-night-950/80 backdrop-blur-md border-b border-night-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <a href="#accueil" class="font-mono text-xl font-bold text-cyber-blue tracking-tighter">
            JMM.dev
          </a>
          
          <!-- Desktop nav -->
          <div class="hidden md:flex space-x-8">
            <a href="#accueil" class="text-slate-400 hover:text-cyber-blue transition-colors text-xs uppercase tracking-widest font-medium">Accueil</a>
            <a href="#parcours" class="text-slate-400 hover:text-cyber-blue transition-colors text-xs uppercase tracking-widest font-medium">Parcours</a>
            <a href="#competences" class="text-slate-400 hover:text-cyber-blue transition-colors text-xs uppercase tracking-widest font-medium">Compétences</a>
            <a href="#projets" class="text-slate-400 hover:text-cyber-blue transition-colors text-xs uppercase tracking-widest font-medium">Projets</a>
            <a href="#faq" class="text-slate-400 hover:text-cyber-blue transition-colors text-xs uppercase tracking-widest font-medium">FAQ</a>
            <a href="#contact" class="text-slate-400 hover:text-cyber-blue transition-colors text-xs uppercase tracking-widest font-medium">Contact</a>
          </div>
          
          <!-- Burger button -->
          <button
            id="mobile-menu-button"
            class="md:hidden relative z-50 flex flex-col justify-center items-center w-10 h-10 gap-[5px] group"
            aria-label="Menu"
          >
            <span id="burger-line-1" class="block w-6 h-[2px] bg-slate-400 rounded-full transition-all duration-300 ease-in-out group-hover:bg-cyber-blue"></span>
            <span id="burger-line-2" class="block w-6 h-[2px] bg-slate-400 rounded-full transition-all duration-300 ease-in-out group-hover:bg-cyber-blue"></span>
            <span id="burger-line-3" class="block w-4 h-[2px] bg-slate-400 rounded-full transition-all duration-300 ease-in-out group-hover:bg-cyber-blue self-start"></span>
          </button>
        </div>
      </div>
    </nav>

    <!-- Mobile Menu Overlay -->
    <div
      id="mobile-menu"
      class="fixed inset-0 z-40 flex flex-col md:hidden pointer-events-none opacity-0"
      style="transition: opacity 0.35s cubic-bezier(0.4,0,0.2,1);"
    >
      <!-- Backdrop blur layer -->
      <div class="absolute inset-0 bg-night-950/95 backdrop-blur-xl"></div>

      <!-- Decorative grid -->
      <div class="absolute inset-0 opacity-5 pointer-events-none">
        <div class="absolute inset-0" style="background-image: linear-gradient(#00d9ff 1px, transparent 1px), linear-gradient(90deg, #00d9ff 1px, transparent 1px); background-size: 40px 40px;"></div>
      </div>

      <!-- Decorative glow -->
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-64 h-64 bg-cyber-blue/10 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Nav links -->
      <nav class="relative z-10 flex flex-col items-center justify-center flex-1 gap-2 pt-16">
        <p class="text-[10px] font-mono uppercase tracking-[0.3em] text-slate-600 mb-6">Navigation</p>

        {[
          { href: '#accueil', label: 'Accueil', num: '01' },
          { href: '#parcours', label: 'Parcours', num: '02' },
          { href: '#competences', label: 'Compétences', num: '03' },
          { href: '#projets', label: 'Projets', num: '04' },
          { href: '#faq', label: 'FAQ', num: '05' },
          { href: '#contact', label: 'Contact', num: '06' },
        ].map(({ href, label, num }) => (
          <a
            href={href}
            data-mobile-link
            class="mobile-nav-link group flex items-center gap-4 px-8 py-3 w-full max-w-xs rounded-sm hover:bg-night-800 transition-all duration-200"
          >
            <span class="text-[10px] font-mono text-cyber-blue/40 group-hover:text-cyber-blue transition-colors">{num}</span>
            <span class="text-2xl font-bold text-white uppercase tracking-wider group-hover:text-cyber-blue transition-colors">{label}</span>
            <span class="ml-auto opacity-0 group-hover:opacity-100 transition-opacity text-cyber-blue">→</span>
          </a>
        ))}

        <!-- CTA -->
        <a
          href="https://drive.google.com/file/d/1SSyVmkj5LcFCKE7AUuJ1U7TztF5efOID/view?usp=drive_link"
          target="_blank"
          data-mobile-link
          class="mt-8 px-8 py-3 bg-cyber-blue text-night-950 font-bold font-mono text-sm rounded-sm hover:bg-white transition-all duration-300"
        >
          TÉLÉCHARGER_CV
        </a>
      </nav>

      <!-- Footer ligne -->
      <div class="relative z-10 flex justify-center pb-8">
        <span class="text-[10px] font-mono text-slate-700 uppercase tracking-[0.2em]">JMM.dev © 2026</span>
      </div>
    </div>
    
    <main>
      <slot />
    </main>
    
    <footer class="bg-night-950 border-t border-night-800 py-12 mt-20">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <h3 class="text-white font-bold mb-4">Josué Mbah Moffo</h3>
        <p class="text-slate-500 text-sm max-w-md mx-auto mb-8">
          Ingénieur en formation à l'ENSPY. Spécialisation en développement sécurisé et administration systèmes.
        </p>
        <div class="flex justify-center space-x-6 text-xs uppercase tracking-widest">
          <a href="https://github.com/JosueMoffo" onclick="window.trackClick('Social_Link', { platform: 'GitHub' })" class="text-slate-400 hover:text-cyber-blue">GitHub</a>
          <a href="https://www.linkedin.com/in/josue-moffo-07b756352/" onclick="window.trackClick('Social_Link', { platform: 'Linkedin' })" class="text-slate-400 hover:text-cyber-blue">LinkedIn</a>
          <a href="mailto:josuemoffo@gmail.com" onclick="window.trackClick('Social_Link', { platform: 'Gmail' })" class="text-slate-400 hover:text-cyber-blue">📧 Contact</a>
        </div>
        <p class="mt-8 text-[10px] text-slate-700 uppercase tracking-[0.2em]">&copy; 2026 Tous droits réservés</p>
      </div>
    </footer>

    <Analytics />
    <SpeedInsights />

    <script>
      import { track } from '@vercel/analytics';

      // On utilise 'as any' pour éviter les erreurs de type TypeScript sur l'objet window
      (window as any).trackClick = (eventName, properties = {}) => { 
        track(eventName, properties);
      };
    </script>

    <script>
      const btn = document.getElementById('mobile-menu-button');
      const menu = document.getElementById('mobile-menu');
      const line1 = document.getElementById('burger-line-1');
      const line2 = document.getElementById('burger-line-2');
      const line3 = document.getElementById('burger-line-3');
      let isOpen = false;

      function openMenu() {
        isOpen = true;
        menu.style.opacity = '1';
        menu.style.pointerEvents = 'auto';
        document.body.style.overflow = 'hidden';
        // Animate burger → X
        line1.style.transform = 'translateY(7px) rotate(45deg)';
        line2.style.opacity = '0';
        line2.style.transform = 'scaleX(0)';
        line3.style.transform = 'translateY(-7px) rotate(-45deg)';
        line3.style.width = '1.5rem';
      }

      function closeMenu() {
        isOpen = false;
        menu.style.opacity = '0';
        menu.style.pointerEvents = 'none';
        document.body.style.overflow = '';
        // Reset burger
        line1.style.transform = '';
        line2.style.opacity = '';
        line2.style.transform = '';
        line3.style.transform = '';
        line3.style.width = '';
      }

      btn?.addEventListener('click', () => isOpen ? closeMenu() : openMenu());

      // Ferme au clic sur un lien
      document.querySelectorAll('[data-mobile-link]').forEach(link => {
        link.addEventListener('click', closeMenu);
      });
    </script>
  </body>
</html>