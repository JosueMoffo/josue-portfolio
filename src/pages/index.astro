---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Josué Mbah Moffo - Portfolio">

  <!-- ══ HERO ══════════════════════════════════════════════════ -->
  <section id="accueil" style="min-height:100vh;padding:8rem 1.5rem 4rem;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;">
    <div class="grid-bg"></div>
    <div style="position:absolute;top:20%;right:10%;width:320px;height:320px;background:rgba(var(--accent-rgb),0.04);border-radius:50%;filter:blur(80px);pointer-events:none;"></div>

    <div style="max-width:860px;margin:0 auto;text-align:center;position:relative;z-index:2;">

      <!-- Photo -->
      <div class="animate-fade-in" style="display:inline-block;position:relative;margin-bottom:1.5rem;">
        <div style="position:absolute;inset:-4px;border-radius:50%;background:var(--accent);opacity:0.12;filter:blur(16px);"></div>
        <img
          src="/profile.png" alt="Josué Mbah Moffo"
          style="position:relative;width:120px;height:120px;border-radius:50%;object-fit:cover;border:2px solid var(--accent);box-shadow:0 0 24px rgba(var(--accent-rgb),0.18);"
        />
      </div>

      <h1 class="animate-fade-in-up delay-100" style="font-size:clamp(2.4rem,7vw,4.2rem);font-weight:700;line-height:1.1;margin:0 0 8px;color:var(--text-primary);">
        Mbah Moffo <span style="color:var(--accent);">Josué</span>
      </h1>

      <h2 class="animate-fade-in-up delay-200" style="font-size:clamp(1rem,3vw,1.3rem);color:var(--text-secondary);margin:0 0 8px;font-weight:400;">
        Étudiant en Génie Informatique
      </h2>

      <p class="animate-fade-in-up delay-200" style="font-family:'Fira Code',monospace;font-size:0.75rem;letter-spacing:0.22em;text-transform:uppercase;color:var(--accent);opacity:0.85;margin:0 0 1.5rem;">
        Backend Developer orienté Sécurité
      </p>

      <div class="animate-fade-in delay-300" style="display:flex;justify-content:center;margin-bottom:2rem;">
        <div class="hero-status">
          <div class="ping-wrapper">
            <span class="ping-ring"></span>
            <span class="ping-dot"></span>
          </div>
          <span style="font-size:0.62rem;font-family:'Fira Code',monospace;letter-spacing:0.14em;text-transform:uppercase;color:var(--text-muted);">
            Dernière mise à jour : <span style="color:var(--text-primary);">15 Avril 2026</span>
          </span>
        </div>
      </div>

      <p class="animate-fade-in-up delay-300" style="color:var(--text-secondary);font-size:1.05rem;line-height:1.75;max-width:580px;margin:0 auto 2.5rem;">
        Focus sur le développement d'applications robustes et l'administration sécurisée des infrastructures réseaux.
      </p>

      <div class="animate-fade-in-up delay-400 cta-group" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
        <a href="https://drive.google.com/file/d/1SSyVmkj5LcFCKE7AUuJ1U7TztF5efOID/view?usp=drive_link"
           target="_blank" onclick="window.trackClick('Download_CV',{})" class="btn-primary" style="letter-spacing:0.08em;">
          TÉLÉCHARGER_CV
        </a>
        <a href="#contact" onclick="window.trackClick('Contact_Click',{})" class="btn-outline">
          ME_CONTACTER
        </a>
      </div>
    </div>

    <div style="position:absolute;bottom:32px;left:50%;transform:translateX(-50%);opacity:0.15;">
      <div style="width:1px;height:48px;background:linear-gradient(to bottom,var(--accent),transparent);animation:pulse 2s infinite;"></div>
    </div>
  </section>

  <!-- ══ PARCOURS ══════════════════════════════════════════════ -->
  <section id="parcours" class="section-alt" style="padding:5rem 1.5rem;">
    <div style="max-width:1280px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:4rem;">
        <h2 class="section-title">Parcours Académique</h2>
        <div class="section-bar"></div>
      </div>

      <div style="max-width:720px;margin:0 auto;display:flex;flex-direction:column;gap:2.5rem;">

        <div class="timeline-line" style="position:relative;padding-left:2rem;">
          <div style="position:absolute;left:-7px;top:0;width:14px;height:14px;border-radius:50%;background:var(--accent);"></div>
          <div style="margin-bottom:6px;">
            <span style="display:inline-block;padding:2px 10px;border-radius:4px;font-size:0.68rem;font-family:'Fira Code',monospace;font-weight:600;background:var(--tag-bg);color:var(--accent);">2022 — Présent</span>
          </div>
          <h3 style="font-size:1.3rem;font-weight:700;color:var(--text-primary);margin:0 0 6px;">Génie Informatique — 4e année</h3>
          <p style="color:var(--text-secondary);margin:0 0 4px;">École Nationale Supérieure Polytechnique de Yaoundé (ENSPY)</p>
          <p style="color:var(--text-muted);font-size:0.85rem;margin:0;">Yaoundé, Cameroun</p>
        </div>

        <div class="timeline-line" style="position:relative;padding-left:2rem;">
          <div style="position:absolute;left:-7px;top:0;width:14px;height:14px;border-radius:50%;background:var(--text-muted);"></div>
          <div style="margin-bottom:6px;">
            <span style="display:inline-block;padding:2px 10px;border-radius:4px;font-size:0.68rem;font-family:'Fira Code',monospace;font-weight:600;background:var(--tag-bg);color:var(--text-muted);">2021 — 2022</span>
          </div>
          <h3 style="font-size:1.3rem;font-weight:700;color:var(--text-primary);margin:0 0 6px;">Formation en Mathématiques</h3>
          <p style="color:var(--text-secondary);margin:0 0 4px;">Université de Yaoundé 1</p>
          <p style="color:var(--text-muted);font-size:0.85rem;margin:0;">Yaoundé, Cameroun</p>
        </div>

        <div class="timeline-line" style="position:relative;padding-left:2rem;">
          <div style="position:absolute;left:-7px;top:0;width:14px;height:14px;border-radius:50%;background:var(--text-muted);"></div>
          <div style="margin-bottom:6px;">
            <span style="display:inline-block;padding:2px 10px;border-radius:4px;font-size:0.68rem;font-family:'Fira Code',monospace;font-weight:600;background:var(--tag-bg);color:var(--text-muted);">2021</span>
          </div>
          <h3 style="font-size:1.3rem;font-weight:700;color:var(--text-primary);margin:0 0 6px;">Baccalauréat Série C</h3>
          <p style="color:var(--text-secondary);margin:0 0 4px;">Sciences Mathématiques</p>
          <p style="color:var(--text-muted);font-size:0.85rem;margin:0;">Cameroun</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ══ COMPÉTENCES ═══════════════════════════════════════════ -->
  <section id="competences" class="section-dark" style="padding:5rem 1.5rem;">
    <div style="max-width:1280px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:4rem;">
        <h2 class="section-title">Compétences Techniques</h2>
        <div class="section-bar"></div>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem;">

        <div class="card" style="padding:1.5rem;" id="card-dev">
          <h3 style="font-size:1.05rem;font-weight:700;color:var(--accent);margin:0 0 1rem;">Développement</h3>
          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:1rem;">
            {['JavaScript','TypeScript','PHP','C','Python','Java'].map(s => <span class="tag">{s}</span>)}
          </div>
          <div style="border-top:1px solid var(--border-color);padding-top:1rem;">
            <p style="font-size:0.72rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin:0 0 8px;font-weight:600;">Frameworks</p>
            <div style="display:flex;flex-wrap:wrap;gap:8px;">
              {['Astro','Django','FastAPI','SpringBoot','Tailwind CSS'].map(s => <span class="tag">{s}</span>)}
            </div>
          </div>
        </div>

        <div class="card" style="padding:1.5rem;">
          <h3 style="font-size:1.05rem;font-weight:700;color:var(--cyber-purple,#a78bfa);margin:0 0 1rem;" class="card-title-purple">Infrastructure & Réseaux</h3>
          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:1rem;">
            {['Linux','Windows','SNMP','Nagios'].map(s => <span class="tag">{s}</span>)}
          </div>
          <div style="border-top:1px solid var(--border-color);padding-top:1rem;">
            <p style="font-size:0.72rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin:0 0 8px;font-weight:600;">Outils</p>
            <div style="display:flex;flex-wrap:wrap;gap:8px;">
              {['Cisco Packet Tracer','Wireshark','VirtualBox'].map(s => <span class="tag">{s}</span>)}
            </div>
          </div>
        </div>

        <div class="card" style="padding:1.5rem;">
          <h3 style="font-size:1.05rem;font-weight:700;color:#10b981;margin:0 0 1rem;">DevOps & Cloud</h3>
          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:1rem;">
            {['Docker','Git','Bash','Firebase'].map(s => <span class="tag">{s}</span>)}
          </div>
          <div style="border-top:1px solid var(--border-color);padding-top:1rem;">
            <p style="font-size:0.72rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin:0 0 8px;font-weight:600;">Plateformes</p>
            <div style="display:flex;flex-wrap:wrap;gap:8px;">
              {['Supabase','Vercel','Render'].map(s => <span class="tag">{s}</span>)}
            </div>
          </div>
        </div>

        <div class="card" style="padding:1.5rem;">
          <h3 style="font-size:1.05rem;font-weight:700;color:var(--accent);margin:0 0 1rem;">Base de Données</h3>
          <div style="display:flex;flex-wrap:wrap;gap:8px;">
            {['MySQL','PostgreSQL','Firebase'].map(s => <span class="tag">{s}</span>)}
          </div>
        </div>

        <div class="card" style="padding:1.5rem;grid-column:span 1;" id="security-card">
          <h3 style="font-size:1.05rem;font-weight:700;color:#ef4444;margin:0 0 1rem;">Sécurité </h3>
          <div style="display:flex;flex-wrap:wrap;gap:8px;">
            {['Analyse de vulnérabilités','Metasploitable','Penetration Testing'].map(s => <span class="tag">{s}</span>)}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══ PROJETS ════════════════════════════════════════════════ -->
  <section id="projets" class="section-alt" style="padding:5rem 1.5rem;">
    <div style="max-width:1280px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:3rem;">
        <h2 class="section-title">Projets Personnels</h2>
        <div class="section-bar"></div>
      </div>

        <!-- Shuba -->
        <div class="card-inner" style="padding:2rem;">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:1rem;flex-wrap:wrap;">
            <h3 style="font-size:1.2rem;font-weight:700;color:var(--text-primary);margin:0;flex:1;">Shuba: Une Marketplace Multi-tenant</h3>
            <span style="padding:3px 10px;font-family:'Fira Code',monospace;font-size:0.68rem;border-radius:4px;background:rgba(16,185,129,0.1);color:#10b981;border:1px solid rgba(16,185,129,0.2);white-space:nowrap;">Django</span>
          </div>
          <p style="color:var(--text-secondary);line-height:1.72;margin:0 0 1.2rem;font-size:0.92rem;">Plateforme e-commerce complète développée avec Django. Gestion avancée des produits, paniers d'achat, systèmes de paiement, authentification sécurisée et interface d'administration.</p>
          <div style="display:flex;flex-wrap:wrap;gap:7px;margin-bottom:1.2rem;">
            {['Python','Django','PostgreSQL','Backend Focus'].map(s => <span class="tag">{s}</span>)}
          </div>
          <div style="display:flex;flex-direction:column;gap:8px;">
            <a href="https://shuba.onrender.com" target="_blank" onclick="window.trackClick('View_Project',{name:'Marketplace'})" class="project-link" style="color:#10b981;">
              Explorer l'application en production
              <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
            <a href="https://github.com/JosueMoffo/saas-marketplace" target="_blank" onclick="window.trackClick('View_Project',{name:'Marketplace_GH'})" class="project-link" style="color:#10b981;">
              Voir sur GitHub
              <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </div>
        </div>
        <br>

      <div style="text-align:center;margin-bottom:4rem;">
        <h2 class="section-title">Projets Académiques</h2>
        <div class="section-bar"></div>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1.5rem;">

        <!-- API-Rsv -->
        <div class="card-inner" style="padding:2rem;">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:1rem;flex-wrap:wrap;">
            <h3 style="font-size:1.2rem;font-weight:700;color:var(--text-primary);margin:0;flex:1;">API-Rsv-TravYotei</h3>
            <span style="padding:3px 10px;font-family:'Fira Code',monospace;font-size:0.68rem;border-radius:4px;background:rgba(var(--accent-rgb),0.1);color:var(--accent);border:1px solid rgba(var(--accent-rgb),0.2);white-space:nowrap;">SpringBoot</span>
          </div>
          <p style="color:var(--text-secondary);line-height:1.72;margin:0 0 1.2rem;font-size:0.92rem;">Système de gestion de réservations utilisant SpringBoot et Apache Kafka pour une communication asynchrone robuste entre microservices. Architecture orientée événements.</p>
          <div style="display:flex;flex-wrap:wrap;gap:7px;margin-bottom:1.2rem;">
            {['Java','SpringBoot','Apache Kafka','Microservices'].map(s => <span class="tag">{s}</span>)}
          </div>
          <a href="https://github.com/JosueMoffo/API-Rsv-TravYotei" target="_blank" onclick="window.trackClick('View_Project',{name:'API-Rsv-TravYotei'})" class="project-link">
            Voir sur GitHub
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>

        <!-- Recommendation -->
        <div class="card-inner" style="padding:2rem;">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:1rem;flex-wrap:wrap;">
            <h3 style="font-size:1.2rem;font-weight:700;color:var(--text-primary);margin:0;flex:1;">API-recommendation-systeme</h3>
            <span style="padding:3px 10px;font-family:'Fira Code',monospace;font-size:0.68rem;border-radius:4px;background:rgba(167,139,250,0.1);color:#a78bfa;border:1px solid rgba(167,139,250,0.2);white-space:nowrap;">Flask</span>
          </div>
          <p style="color:var(--text-secondary);line-height:1.72;margin:0 0 1.2rem;font-size:0.92rem;">API de recommandation intelligente pour bibliothèque utilisant des algorithmes de Machine Learning. Analyse les préférences utilisateurs et suggère des ouvrages pertinents.</p>
          <div style="display:flex;flex-wrap:wrap;gap:7px;margin-bottom:1.2rem;">
            {['Python','Flask','Machine Learning','Railway'].map(s => <span class="tag">{s}</span>)}
          </div>
          <a href="https://recommendation.up.railway.app" target="_blank" onclick="window.trackClick('View_Project',{name:'API-recommendation'})" class="project-link" style="color:#a78bfa;">
            Voir la démo
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>

        <!-- TravYotei -->
        <div class="card-inner" style="padding:2rem;">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:6px;flex-wrap:wrap;">
            <div style="flex:1;">
              <h3 style="font-size:1.2rem;font-weight:700;color:var(--text-primary);margin:0 0 4px;">TravYotei — Planification de Voyages</h3>
              <p style="color:var(--accent);font-size:0.75rem;font-family:'Fira Code',monospace;margin:0;">Application Fullstack • Projet Académique ENSPY</p>
            </div>
            <span style="padding:3px 10px;font-family:'Fira Code',monospace;font-size:0.68rem;border-radius:4px;background:rgba(var(--accent-rgb),0.1);color:var(--accent);border:1px solid rgba(var(--accent-rgb),0.2);white-space:nowrap;">Next.js + SpringBoot</span>
          </div>
          <p style="color:var(--text-secondary);line-height:1.72;margin:0 0 1.2rem;font-size:0.92rem;">Solution complète de digitalisation du transport interurbain au Cameroun. Planification de trajets, gestion des agences et réservation en temps réel sur architecture microservices.</p>
          <div style="display:flex;flex-wrap:wrap;gap:7px;margin-bottom:1.2rem;">
            {['TypeScript','Astro/React','Tailwind CSS','Spring Boot API','Kafka','Vercel'].map(s => <span class="tag">{s}</span>)}
          </div>
          <a href="https://frontend-travyotei.vercel.app/" target="_blank" onclick="window.trackClick('View_Project',{name:'TravYotei_Frontend'})" class="project-link">
            Explorer l'application
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ══ FAQ ═══════════════════════════════════════════════════ -->
  <section id="faq" class="section-dark" style="padding:5rem 1.5rem;">
    <div style="max-width:760px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:4rem;">
        <h2 class="section-title">Questions Fréquentes</h2>
        <div class="section-bar"></div>
      </div>

      <div style="display:flex;flex-direction:column;gap:12px;">

        <div class="faq-item">
          <button class="faq-trigger" aria-expanded="false">
            <span class="faq-question">Quel est votre rythme de disponibilité ?</span>
            <svg class="faq-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              Actuellement en formation à l'ENSPY, je suis disponible pour des stages ou missions freelance en parallèle de mes études. Je peux m'adapter aux besoins du projet tout en maintenant un équilibre avec mon parcours académique.
            </div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-trigger" aria-expanded="false">
            <span class="faq-question">Pourquoi ce double profil Dev et Réseau ?</span>
            <svg class="faq-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              Pour comprendre l'application de la couche logicielle jusqu'à la transmission physique des données, étape cruciale pour la cybersécurité. Cette approche me permet d'appréhender les systèmes informatiques dans leur globalité, de l'infrastructure réseau aux applications utilisateur. Ce qui est essentiel pour identifier et corriger les vulnérabilités.
            </div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-trigger" aria-expanded="false">
            <span class="faq-question">Quels sont vos prochains objectifs techniques ?</span>
            <svg class="faq-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              L'approfondissement de la sécurité offensive à travers la pratique du penetration testing et l'obtention de certifications professionnelles, notamment les certifications Cisco (CCNA) et CompTIA Security+. Je continue également à développer mes compétences en analyse de vulnérabilités et en administration sécurisée des infrastructures.
            </div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-trigger" aria-expanded="false">
            <span class="faq-question">Acceptez-vous des missions freelance ou à distance ?</span>
            <svg class="faq-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              Oui, tout à fait. Je suis ouvert aux collaborations à distance (remote) et aux missions ponctuelles sur des projets backend, API REST, architecture microservices ou sécurisation d'applications. N'hésitez pas à me contacter via le formulaire ci-dessous pour discuter de vos besoins.
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══ CONTACT ═══════════════════════════════════════════════ -->
  <section id="contact" class="section-alt" style="padding:5rem 1.5rem;">
    <div style="max-width:900px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:4rem;">
        <h2 class="section-title">Entrons en Contact</h2>
        <div class="section-bar" style="margin-bottom:1rem;"></div>
        <p style="color:var(--text-secondary);font-size:1rem;">N'hésitez pas à me contacter pour discuter de projets, opportunités ou collaborations</p>
      </div>

      <!-- Infos rapides -->
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;margin-bottom:2rem;">
        <div class="card" style="padding:1.75rem;text-align:center;">
