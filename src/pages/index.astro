  <!-- Script de filtrage et contrôle de modal -->
  <script define:vars={{ projects }}>
    // ── FILTRAGE INTERACTIF ──────────────────────────────────────────
    const filterButtons = document.querySelectorAll('.filter-pill');
    const projectCards = document.querySelectorAll('.project-bento-card');

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        filterButtons.forEach(btn => {
          btn.classList.remove('active');
          btn.setAttribute('style', "font-family:'Fira Code',monospace;font-size:0.75rem;font-weight:600;color:var(--text-secondary);background:transparent;border:none;padding:8px 18px;border-radius:999px;cursor:pointer;transition:all 0.25s ease;");
        });
        button.classList.add('active');
        button.setAttribute('style', "font-family:'Fira Code',monospace;font-size:0.75rem;font-weight:600;color:var(--text-primary);background:var(--bg-card);border:none;padding:8px 18px;border-radius:999px;cursor:pointer;transition:all 0.25s ease;box-shadow:0 2px 8px rgba(0,0,0,0.15);");

        const filterValue = button.getAttribute('data-filter');

        projectCards.forEach(card => {
          const cardStatus = card.getAttribute('data-status');
          const isTop = card.getAttribute('data-is-top') === 'true';
          const cardElement = card;

          let shouldShow = false;
          if (filterValue === 'all') {
            shouldShow = true;
          } else if (filterValue === 'top') {
            shouldShow = isTop;
          } else if (cardStatus === filterValue) {
            shouldShow = true;
          }

          if (shouldShow) {
            cardElement.style.display = 'flex';
            setTimeout(() => {
              cardElement.style.opacity = '1';
              cardElement.style.transform = 'scale(1)';
            }, 10);
          } else {
            cardElement.style.opacity = '0';
            cardElement.style.transform = 'scale(0.95)';
            setTimeout(() => {
              cardElement.style.display = 'none';
            }, 250);
          }
        });
      });
    });

    // ── GESTION DE LA FENETRE MODALE DE SPECIFICATIONS ───────────────
    const modal = document.getElementById('project-modal');
    const modalContent = modal.querySelector('.modal-content');
    const btnCloseModal = document.getElementById('btn-close-modal');
    const btnOpenDetails = document.querySelectorAll('.btn-open-details');

    const modalHeaderId = document.getElementById('modal-header-id');
    const modalTitle = document.getElementById('modal-title');
    const modalCategory = document.getElementById('modal-category');
    const modalStatusBadge = document.getElementById('modal-status-badge');
    const modalVisualGradient = document.getElementById('modal-visual-gradient');
    const modalVisualStack = document.getElementById('modal-visual-stack');
    const modalDescription = document.getElementById('modal-description');
    const modalSpecArch = document.getElementById('modal-spec-arch');
    const modalSpecTools = document.getElementById('modal-spec-tools');
    const modalSpecChallenges = document.getElementById('modal-spec-challenges');
    const modalLinksContainer = document.getElementById('modal-links-container');

    const arrowSvg = `<svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>`;

    function openModal(project) {
      modalHeaderId.textContent = `${project.id}-specs-compiling.log`;
      modalTitle.textContent = project.title;
      modalCategory.textContent = project.category;
      modalDescription.textContent = project.description;
      
      if (project.status === 'completed') {
        modalStatusBadge.textContent = '✓ PRODUCTION';
        modalStatusBadge.setAttribute('style', 'background:rgba(16,185,129,0.08);color:#10b981;border:1px solid rgba(16,185,129,0.2);padding:2px 8px;border-radius:4px;');
      } else {
        modalStatusBadge.textContent = '⚡ EN_COURS';
        modalStatusBadge.setAttribute('style', 'background:rgba(245,158,11,0.08);color:#f59e0b;border:1px solid rgba(245,158,11,0.2);padding:2px 8px;border-radius:4px;');
      }

      if (project.image) {
        modalVisualGradient.setAttribute('style', `background: linear-gradient(to bottom, rgba(10,14,26,0.3), rgba(10,14,26,0.85)), url(${project.image}) center/cover no-repeat; height:60px; border-radius:4px; position:relative; display:flex; align-items:center; justify-content:center; overflow:hidden; opacity:0.85;`);
      } else {
        modalVisualGradient.setAttribute('style', `background:${project.previewGradient}; height:60px; border-radius:4px; position:relative; display:flex; align-items:center; justify-content:center; overflow:hidden; opacity:0.85;`);
      }
      modalVisualStack.textContent = project.tags.join(' / ');

      modalSpecArch.textContent = project.technicalDetails.architecture;
      modalSpecTools.textContent = project.technicalDetails.tools.join(', ');
      modalSpecChallenges.textContent = project.technicalDetails.challenges;

      modalLinksContainer.innerHTML = '';
      project.links.forEach((link) => {
        const a = document.createElement('a');
        a.href = link.url;
        a.target = '_blank';
        a.className = 'project-link';
        a.style.color = link.colorStyle;
        a.style.fontSize = '0.85rem';
        a.style.fontFamily = "'Fira Code',monospace";
        a.innerHTML = `${link.label} ${arrowSvg}`;
        a.addEventListener('click', () => {
          window.trackClick?.(link.trackEvent, { name: link.trackName });
        });
        modalLinksContainer.appendChild(a);
      });

      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      setTimeout(() => {
        modal.style.opacity = '1';
        modalContent.style.transform = 'scale(1)';
      }, 10);
    }

    function closeModal() {
      modal.style.opacity = '0';
      modalContent.style.transform = 'scale(0.95)';
      document.body.style.overflow = '';
      setTimeout(() => {
        modal.style.display = 'none';
      }, 250);
    }

    btnOpenDetails.forEach(button => {
      button.addEventListener('click', (e) => {
        const card = button.closest('.project-bento-card');
        const projectId = card.getAttribute('data-id');
        const projectData = projects.find((p) => p.id === projectId);
        if (projectData) {
          openModal(projectData);
        }
      });
    });

    btnCloseModal.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.style.display === 'flex') closeModal();
    });
  </script>




